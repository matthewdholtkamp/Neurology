# Build output
site/

# Python
.venv/
venv/
__pycache__/
*.pyc

# OS
.DS_Store

# Local editor / tooling settings. Machine-specific settings stay local, but the
# shared authoring pipeline (skills, slash commands, project settings) is COMMITTED
# so it behaves identically on every machine and in web sessions.
.claude/*
!.claude/skills/
!.claude/commands/
!.claude/settings.json
.claude/settings.local.json

# Source material — copyrighted PDFs / drafts, kept local, never published.
# Anchored to the repo root and named distinctly so it can NEVER collide with
# a content path like docs/headache/ (macOS gitignore matching is case-insensitive).
/_source/
