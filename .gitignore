# Build output
site/

# Python
.venv/
venv/
__pycache__/
*.pyc

# OS
.DS_Store

# Local editor / tooling settings stay local. The shared authoring/review pipeline
# (skills, slash commands, agents, project settings) is COMMITTED so it travels with
# a fresh clone. (Tracked != runs remotely: nothing in CI runs these.)
.claude/*
!.claude/skills/
!.claude/commands/
!.claude/agents/
!.claude/settings.json
.claude/settings.local.json

# Source material — copyrighted PDFs / drafts, kept local, never published.
# Anchored to the repo root and named distinctly so it can NEVER collide with
# a content path like docs/headache/ (macOS gitignore matching is case-insensitive).
/_source/

# Review pipeline working files. These hold pasted OpenEvidence output — their
# copyrighted text, under terms that restrict reuse — so they must NEVER reach a
# public repo. The durable products (ledger, changelog) get promoted into the page
# commit; the raw paste dies on this machine. The scorecard is the one exception:
# it is our own accumulated learning, so it IS tracked.
/review/*
!/review/_scorecard.md
!/review/README.md
# The ledger and changelog ARE our own work and are the permanent audit trail behind
# a page's "Verified MON YYYY" footer, so they ship with the page. Everything else in
# a review folder — including the OpenEvidence paste — stays local.
!/review/*/
/review/*/*
!/review/*/40-ledger.md
!/review/*/50-changelog.md
